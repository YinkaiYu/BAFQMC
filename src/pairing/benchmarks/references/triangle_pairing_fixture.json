    },
    "kinetic_total_lq_alias": {
      "expected_from": "observables.kinetic_total.value",
      "atol": 1e-12,
      "rtol": 0.0,
      "dqmc": {"operation": "mean_times_lq", "files": ["kinetic"], "min_samples": 2}
    },
    "local_numsquare": {
      "expected_from": "observables.local_numsquare.value",
      "atol": 1e-12,
      "rtol": 0.0,
      "dqmc": {"operation": "mean", "files": ["local_numsquare"], "min_samples": 2}
    },
    "pair_equal": {
      "expected_from": "observables.pair_equal.value",
      "atol": 1e-12,
      "rtol": 0.0,
